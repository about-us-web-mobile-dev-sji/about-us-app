# Copier les valeurs utiles dans .env ; ne pas committer les secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
# Générer avec : openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=about-us
PORT=3000
NODE_ENV=development
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_FIRST_NAME=Admin
SUPER_ADMIN_LAST_NAME=Local
# Obligatoire pour initialiser l’identité EMAIL ; au plus 72 octets UTF-8.
SUPER_ADMIN_PASSWORD=

# Base persistante. Utiliser le même fichier pour tous les processus du backend.
DATABASE_PATH=./data/about-us.sqlite

# Connexion TypeORM MySQL/MariaDB déclarée dans AppModule.
# Les repositories User/Auth utilisent encore DATABASE_PATH (SQLite).
DATABASE_TYPE=mysql
DATABASE_HOST=localhost
DATABASE_PORT=3306
DATABASE_USERNAME=app_user
DATABASE_PASSWORD=
DATABASE_NAME=about_us

# Copier les valeurs utiles dans .env ; ne pas committer les secrets.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/web/google/callback
# Origine exacte du frontend Web (cookies et protection CSRF).
AUTH_WEB_ORIGIN=http://localhost:4200
# Audiences ID token autorisees, separees par des virgules ; defaut GOOGLE_CLIENT_ID.
GOOGLE_ALLOWED_AUDIENCES=
# Générer avec : openssl rand -hex 32
JWT_SECRET=
JWT_ISSUER=about-us
PORT=3000
NODE_ENV=development
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_FIRST_NAME=Admin
SUPER_ADMIN_LAST_NAME=Local
# Obligatoire pour initialiser l’identité EMAIL ; au plus 72 octets UTF-8.
SUPER_ADMIN_PASSWORD=

# PostgreSQL ; les variables DATABASE_* sont prioritaires sur les anciens DB_*.
DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=app_user
DATABASE_PASSWORD=
DATABASE_NAME=about_us
# Synchroniser les tables depuis les entités TypeORM au démarrage en développement.
DATABASE_SYNCHRONIZE=true
# Tests d’intégration : serveur dédié avec droit CREATE DATABASE.
# TEST_DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres

# Notifications persistantes (PostgreSQL), aucune infrastructure Redis requise.
NOTIFICATIONS_ENABLED=true
NOTIFICATIONS_DEFAULT_LOCALE=fr
NOTIFICATIONS_RETENTION_DAYS=90
NOTIFICATIONS_SECURITY_RETENTION_DAYS=365
NOTIFICATIONS_DELIVERY_RETENTION_DAYS=30
NOTIFICATION_WORKER_INTERVAL_MS=5000
NOTIFICATION_MAX_ATTEMPTS=5
# Désactivé tant que le serveur SMTP n'est pas configuré ; les emails vont en DEAD_LETTER.
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=no-reply@example.com
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
